# Leaderbot runtime (examples only; never commit real values)
NODE_ENV=development
DATABASE_URL=
JWT_SECRET=
APP_BASE_URL=http://localhost:8080
# Public customer portal used for Messenger upgrade buttons.
PORTAL_BASE_URL=https://app.leaderbot.live
# Required when paid `send_portal_handoff` delivery is enabled. Generate a
# dedicated 32+ character secret and deploy the same value to every worker.
# Rotate only after all pending handoff outbox work has drained: rotation makes
# deterministic retry tokens unrecoverable and therefore fail closed.
PORTAL_HANDOFF_TOKEN_SECRET=
# Apply migration 0014 before enabling handoff outbox delivery. Rotate only
# after pending delivery rows drain or expire; a rotated secret mismatching an
# existing delivery operation fails closed rather than minting another link.
BILLING_SUPPORT_EMAIL=billing@example.invalid

# Public Manus WebDev OAuth browser values. These are served at
# /api/public/config at runtime; they are not secrets and do not need to exist
# during `vite build`. VITE_APP_ID is the WebDev OAuth project id, not FB_APP_ID.
OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
VITE_APP_ID=

# Preferred same-origin Facebook Login for the customer portal. The secret is
# server-only. Register this exact valid redirect URI in Meta:
#   ${APP_BASE_URL origin}/api/oauth/callback
FB_APP_ID=
FB_APP_SECRET=
FB_GRAPH_API_VERSION=v21.0

# Conservative per-attempt budget estimate. Before paid Images 2.0 is enabled,
# set this high enough to cover GPT Image 2 output plus edit-input tokens.
OPENAI_IMAGE_ESTIMATED_COST_USD=

# Immutable v2 conversation-identity key. Generate the secret with
# `openssl rand -hex 32`; use a monotonically versioned key id such as `k1`.
# Never reuse FB_APP_SECRET, JWT_SECRET, PRIVACY_PEPPER, or a queue secret.
CONVERSATION_SCOPE_HMAC_KEY_ID=k1
CONVERSATION_SCOPE_HMAC_SECRET=

# Stable HMAC secret for opaque Messenger generation queue partitions. Prefer a
# dedicated random value shared by gateway and worker processes. When blank,
# runtime falls back to FB_APP_SECRET; rotating it changes future partition keys.
MESSENGER_GENERATION_PARTITION_SECRET=
# How long a successfully accepted request id remains deduplicated. Defaults to
# 604800 (7 days) and is clamped to at least lease_seconds * max_attempts.
MESSENGER_GENERATION_ACCEPTED_TTL_SECONDS=604800

# Mollie billing stays in Test Mode until every launch gate is signed off.
# Keep this false while Leaderbot only collects early-access interest.
MOLLIE_BILLING_ENABLED=false
# Separate from checkout so existing paid quotas remain enforced if billing is
# later paused. Enable only after migration and end-to-end entitlement tests.
MOLLIE_ENTITLEMENT_ENFORCEMENT_ENABLED=false
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MOLLIE_MODE=test
MOLLIE_PAYMENT_WEBHOOK_URL=https://example.invalid/api/webhooks/mollie/payments
MOLLIE_LIVE_BILLING_ENABLED=false
MOLLIE_RECONCILIATION_ENABLED=true
MOLLIE_BILLING_WORKER_WORKSPACE_ID=
MOLLIE_WEBHOOK_RATE_LIMIT_PER_MINUTE=6000
