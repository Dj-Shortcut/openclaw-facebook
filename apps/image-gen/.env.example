# Leaderbot runtime (examples only; never commit real values)
NODE_ENV=development
DATABASE_URL=
JWT_SECRET=
# Three-release bridge for the 10-minute Facebook OAuth/Page-selection state.
# Start with legacy_compat while old instances may still run. Move to
# sealed_compat only after they drain, then wait more than 10 minutes before
# sealed_only. Never combine the first dual-reader runtime deploy with a sealed
# write mode. The separate schema migration bridge does not contain this code.
FACEBOOK_CONNECT_STORAGE_MODE=legacy_compat
APP_BASE_URL=http://localhost:8080
# Public customer portal used for Messenger upgrade buttons.
PORTAL_BASE_URL=https://app.leaderbot.live
# Required when paid `send_portal_handoff` delivery is enabled. Generate a
# dedicated 32+ character secret and deploy the same value to every worker.
# Rotate only after all pending handoff outbox work has drained: rotation makes
# deterministic retry tokens unrecoverable and therefore fail closed.
PORTAL_HANDOFF_TOKEN_SECRET=
# Apply migration 0014 before enabling handoff outbox delivery. Rotate only
# after pending delivery rows drain or expire; a rotated secret mismatching an
# existing delivery operation fails closed rather than minting another link.
BILLING_SUPPORT_EMAIL=billing@example.invalid

# Public Manus WebDev OAuth browser values. These are served at
# /api/public/config at runtime; they are not secrets and do not need to exist
# during `vite build`. VITE_APP_ID is the WebDev OAuth project id, not FB_APP_ID.
OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
VITE_APP_ID=

# Preferred same-origin Facebook Login for the customer portal. The secret is
# server-only. Register this exact valid redirect URI in Meta:
#   ${APP_BASE_URL origin}/api/oauth/callback
FB_APP_ID=
FB_APP_SECRET=
FB_GRAPH_API_VERSION=v21.0
# Facebook Login for Business configuration used only by the explicit Page
# connection flow. The configuration owns the exact pages_show_list,
# pages_manage_metadata, pages_messaging and business_management grants.
# Ordinary portal sign-in requests only public_profile and pages_show_list.
FB_PAGE_CONNECT_CONFIG_ID=

# Exact comma-separated Messenger PSIDs for infrastructure owners. These IDs
# keep the existing customer-quota/entitlement behavior while usage remains
# recorded in the metadata-only cost ledger. Never place customer IDs here.
MESSENGER_ADMIN_IDS=

# Production must set this to 0 so one provider invocation cannot automatically
# start a second billable request. Non-production retries require explicit opt-in.
OPENAI_IMAGE_MAX_RETRIES=0

# Immutable v2 conversation-identity key. Generate the secret with
# `openssl rand -hex 32`; use a monotonically versioned key id such as `k1`.
# Never reuse FB_APP_SECRET, JWT_SECRET, PRIVACY_PEPPER, or a queue secret.
CONVERSATION_SCOPE_HMAC_KEY_ID=k1
CONVERSATION_SCOPE_HMAC_SECRET=

# Stable HMAC secret for opaque Messenger generation queue partitions. Prefer a
# dedicated random value shared by gateway and worker processes. When blank,
# runtime falls back to FB_APP_SECRET; rotating it changes future partition keys.
MESSENGER_GENERATION_PARTITION_SECRET=
# Production must set exactly v1 or v2. A safe rollout first deploys the dual
# reader with v1 writes, then activates v2 writes in a config-only release.
MESSENGER_GENERATION_QUEUE_WRITE_VERSION=v2
# Optional; clamped to at most one third of the effective lease.
MESSENGER_GENERATION_LEASE_HEARTBEAT_MS=30000
# How long a successfully accepted request id remains deduplicated. Defaults to
# 604800 (7 days) and is clamped to at least lease_seconds * max_attempts.
MESSENGER_GENERATION_ACCEPTED_TTL_SECONDS=604800
# PII-bearing generation content is capped at 24 hours and never inherits the
# longer metadata/deduplication retention above.
MESSENGER_GENERATION_CONTENT_TTL_SECONDS=86400

# Complete external-call deadlines, including response bodies.
GRAPH_API_REQUEST_TIMEOUT_MS=30000
STORAGE_REQUEST_TIMEOUT_MS=30000
# Exact public R2/custom-domain base returned by the storage proxy. Production
# requires at least one trusted HTTPS base so foreign URLs cannot become delete
# or download keys. Add aliases as a comma-separated list only during a domain
# migration.
PUBLIC_BASE_URL=
STORAGE_PUBLIC_BASE_URLS=
# Temporary rollout bridge only. Production defaults to false/fail-closed.
# Keep true solely while pre-namespace objects still need read/delete support.
STORAGE_ALLOW_LEGACY_KEYS=false
# Storage-proxy-only bridge for old bearer-only app instances during the first
# rolling phase. The main app never consumes this setting.
STORAGE_ALLOW_LEGACY_BEARER_AUTH=false

# Raw webhook content is stored only in the durable Redis ingress envelope.
# The deadline is immutable, must cover lease_seconds * max_attempts, and is
# hard-capped at 24 hours; dead letters retain metadata-only references.
WEBHOOK_INGRESS_CONTENT_TTL_SECONDS=86400
WEBHOOK_INGRESS_DELIVERY_LEASE_SECONDS=900
WEBHOOK_INGRESS_MAX_ATTEMPTS=3

# These legacy spend caps protect audio/video provider paths only. Image
# admission uses only the customer daily/monthly photo quotas below; the
# provider-account hard limit remains the operator's separate final safeguard.
MESSENGER_GLOBAL_DAILY_SPEND_CAP_USD=
MESSENGER_GLOBAL_MONTHLY_SPEND_CAP_USD=
MESSENGER_USER_DAILY_SPEND_CAP_USD=
MESSENGER_FREE_DAILY_LIMIT=5
MESSENGER_FREE_MONTHLY_LIMIT=20
MESSENGER_IMAGE_QUOTA_TIME_ZONE=Europe/Brussels

# Mollie billing stays in Test Mode until every launch gate is signed off.
# Keep this false while Leaderbot only collects early-access interest.
MOLLIE_BILLING_ENABLED=false
# Runs only the provider-silent offline readiness contract while checkout and
# all operational paid-worker flags remain disabled. A green /readyz reports
# phase=offline; it is not sandbox approval and makes no Mollie API call.
MOLLIE_BILLING_PREFLIGHT_ENABLED=false
# Separate from checkout so existing paid quotas remain enforced if billing is
# later paused. Enable only after migration and end-to-end entitlement tests.
MOLLIE_ENTITLEMENT_ENFORCEMENT_ENABLED=false
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MOLLIE_MODE=test
MOLLIE_CREDENTIAL_GENERATION_ID=test-generation-v1
MOLLIE_PAYMENT_WEBHOOK_URL=https://example.invalid/api/webhooks/mollie/payments
MOLLIE_LIVE_BILLING_ENABLED=false
MOLLIE_RECONCILIATION_ENABLED=true
MOLLIE_BILLING_WORKER_WORKSPACE_ID=
# Must be explicit. Use pilot_pin with the workspace id above, or multi_tenant
# with the workspace id unset.
MOLLIE_BILLING_SCHEDULER_MODE=pilot_pin
MOLLIE_WEBHOOK_RATE_LIMIT_PER_MINUTE=6000
# Dedicated 32+ character HMAC key for metadata-only operator evidence hashes.
BILLING_PROFILE_EVIDENCE_HMAC_SECRET=

# Optional GET-only account-level bookkeeping importer. This requires a
# dedicated advanced access token with balances.read; never reuse the payment
# API key. Keep disabled until schema/readiness and receiver evidence are green.
MOLLIE_ACCOUNTING_IMPORT_ENABLED=false
AI_ANSWER_FINALIZATION_DRAIN_ENABLED=false
# Validates the quota schema/lane/worker for the gateway handshake while
# checkout and paid admission remain disabled.
AI_ANSWER_QUOTA_PREFLIGHT_ENABLED=false
MOLLIE_ACCOUNTING_PROVIDER_ACCOUNT_ID=
MOLLIE_ACCOUNTING_BALANCE_ID=
MOLLIE_ACCOUNTING_ACCESS_TOKEN=

# Metadata-only signed billing notifications. Use four distinct 32+ character
# secrets and distinct customer/operator key ids. Never put secrets in URLs.
BILLING_NOTIFICATION_SOURCE_ID=
BILLING_CUSTOMER_NOTIFICATION_WEBHOOK_URL=
BILLING_CUSTOMER_NOTIFICATION_KEY_ID=
BILLING_CUSTOMER_NOTIFICATION_SIGNING_SECRET=
BILLING_OPERATOR_NOTIFICATION_WEBHOOK_URL=
BILLING_OPERATOR_NOTIFICATION_KEY_ID=
BILLING_OPERATOR_NOTIFICATION_SIGNING_SECRET=
BILLING_NOTIFICATION_ORIGIN_ALLOWLIST=
BILLING_NOTIFICATION_RECEIVER_PUBLIC_ORIGIN=
BILLING_NOTIFICATION_RECEIVER_SOURCE_ID=
BILLING_NOTIFICATION_RECEIVER_CUSTOMER_KEY_ID=
BILLING_NOTIFICATION_RECEIVER_CUSTOMER_SIGNING_SECRET=
BILLING_NOTIFICATION_RECEIVER_OPERATOR_KEY_ID=
BILLING_NOTIFICATION_RECEIVER_OPERATOR_SIGNING_SECRET=
BILLING_NOTIFICATION_RECEIVER_PREFLIGHT_ACK=false
# Provider-key-free signed notification receiver/delivery plane.
BILLING_NOTIFICATION_PLANE_ENABLED=false
# Required outside Fly; Fly supplies FLY_MACHINE_ID automatically.
BILLING_SCHEDULER_PROCESS_ID=
