{
  "name": "leaderbot-fb-image-gen",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/index.js",
    "build:docker": "vite build && esbuild server/_core/index.ts --platform=node --bundle --format=cjs --external:vite --outfile=dist/index.cjs && esbuild scripts/run-production-migrations.mjs --platform=node --bundle --format=cjs '--define:import.meta.url=\"file:///app/scripts/migrate-production.mjs\"' --outfile=dist/migrate-production.cjs && esbuild scripts/run-billing-trigger-runtime-preflight.mjs --platform=node --bundle --format=cjs --outfile=dist/billing-trigger-runtime-preflight.cjs && esbuild server/cli/provisionWhatsAppBinding.ts --platform=node --bundle --format=cjs '--define:import.meta.url=\"file:///app/dist/provision-whatsapp-binding.cjs\"' --outfile=dist/provision-whatsapp-binding.cjs",
    "check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:generate-production-contract": "node scripts/generate-production-schema-contract.mjs",
    "db:check-identifiers": "node scripts/rehearse-0015-migration.mjs --check-identifiers-only",
    "db:bridge-production-0007-to-0014": "node scripts/bridge-production-0007-to-0014.mjs",
    "db:migrate:test-bootstrap": "cross-env NODE_ENV=test LEADERBOT_ALLOW_TEST_SCHEMA_BOOTSTRAP=1 LEADERBOT_PRODUCTION_MIGRATION_MODE=apply-empty-bootstrap node scripts/run-production-migrations.mjs",
    "db:test-production-migrator": "node scripts/test-production-migrator.mjs",
    "db:rehearse-0015": "node scripts/rehearse-0015-migration.mjs",
    "db:rehearse-0016": "node scripts/rehearse-0016-migration.mjs",
    "dev": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "deploy:check-docker": "node scripts/check-docker-host.mjs",
    "deploy:verify-portal": "node scripts/verify-portal-production.mjs",
    "fallow": "pnpm dlx fallow@2.27.0 --root .",
    "fallow:list": "pnpm dlx fallow@2.27.0 --root . list",
    "fallow:production": "pnpm dlx fallow@2.27.0 --root . --production",
    "fallow:report": "node scripts/run-fallow-report.mjs --root . --output .fallow/report.json",
    "fallow:report:production": "node scripts/run-fallow-report.mjs --root . --output .fallow/report-production.json -- --production",
    "fallow:summary": "pnpm dlx fallow@2.27.0 --root . --summary --score",
    "fallow:gate": "node scripts/check-fallow-gate.mjs .fallow/report.json",
    "fix:docker": "scripts\\fix-docker.cmd",
    "format": "prettier --write .",
    "format:server:release": "node scripts/format-release-server.mjs",
    "lint": "eslint client/src shared",
    "lint:fix": "eslint client/src shared --fix",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "test": "vitest run",
    "lint:server": "eslint server",
    "lint:server:release": "node scripts/lint-release-server.mjs",
    "lint:server:fix": "eslint server --fix",
    "storage-proxy:install": "pnpm --dir storage-proxy install --frozen-lockfile",
    "storage-proxy:dev": "pnpm --dir storage-proxy start:proxy",
    "storage-proxy:start": "cross-env NODE_ENV=production pnpm --dir storage-proxy start:proxy",
    "whatsapp:provision-binding": "tsx server/cli/provisionWhatsAppBinding.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/node": "^10.69.0",
    "@tanstack/react-query": "^5.102.0",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "ai": "^7.0.47",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.0.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "8.6.2",
    "ioredis": "^6.0.0",
    "jose": "6.2.9",
    "lucide-react": "^1.30.0",
    "mysql2": "^3.23.2",
    "nanoid": "^5.1.16",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.6.0",
    "wouter": "3.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@builder.io/vite-plugin-jsx-loc": "^0.1.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@types/express": "5.0.6",
    "@types/google.maps": "^3.65.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^6.0.3",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.28.1"
}
