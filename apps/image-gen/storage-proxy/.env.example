FORGE_API_KEY=
PUBLIC_BASE_URL=https://assets.example.invalid
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Dedicated shared Redis and HMAC key for fail-closed, tenant-partitioned rate
# limiting. Use a private Redis URL and a random secret of at least 32 bytes.
STORAGE_RATE_LIMIT_REDIS_URL=
STORAGE_RATE_LIMIT_KEY_SECRET=
# Trust Fly-Client-IP only when every public request is guaranteed to traverse
# Fly Proxy. Leave false for local, private-6PN, or alternate-proxy exposure.
STORAGE_TRUST_FLY_CLIENT_IP=false

STORAGE_OPERATION_TIMEOUT_MS=60000
STORAGE_ALLOW_LEGACY_BEARER_AUTH=false
STORAGE_ALLOW_LEGACY_KEYS=false
