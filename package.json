{
  "name": "@dj-shortcut/facebook",
  "version": "2026.7.2-beta.7",
  "private": true,
  "description": "OpenClaw Facebook channel plugin",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.12.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dj-Shortcut/openclaw-facebook.git"
  },
  "bugs": {
    "url": "https://github.com/Dj-Shortcut/openclaw-facebook/issues"
  },
  "homepage": "https://github.com/Dj-Shortcut/openclaw-facebook#readme",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "docs/clawhub-listing.md",
    "docs/clawhub.md",
    "docs/facebook-complete-tutorial.md",
    "docs/openclaw-update.md",
    "docs/operator-prompt-routing.md",
    "docs/setup.md",
    "examples"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/channel-plugin-api.d.ts",
      "default": "./dist/channel-plugin-api.js"
    },
    "./runtime": {
      "types": "./dist/runtime-api.d.ts",
      "default": "./dist/runtime-api.js"
    },
    "./setup": {
      "types": "./dist/setup-entry.d.ts",
      "default": "./dist/setup-entry.js"
    },
    "./configured-state": {
      "types": "./dist/configured-state.d.ts",
      "default": "./dist/configured-state.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "node ./scripts/run-vitest.mjs",
    "test:plugin": "node ./scripts/run-vitest.mjs configured-state.test.ts manifest.test.ts src scripts/update-openclaw.test.mjs",
    "test:production-contracts": "node ./scripts/run-vitest.mjs scripts/check-package-manager-contract.test.mjs scripts/classify-ci-changes.test.mjs scripts/image-gen-credit-migration-principal-repair-contract.test.mjs scripts/image-gen-credit-provisioner-bootstrap-contract.test.mjs scripts/image-gen-migration-smoke-workflow.test.mjs scripts/messenger-smoke-checklist.test.mjs scripts/provision-image-gen-credit-provisioner.test.mjs scripts/retire-image-gen-credit-provisioners.test.mjs scripts/validate-production-deployment.test.mjs",
    "prepare": "npm run build",
    "pack:dry": "npm pack --dry-run",
    "check": "npm run build && npm test && npm run pack:dry",
    "openclaw:update": "node scripts/update-openclaw.mjs",
    "openclaw:validate": "node scripts/validate-openclaw-runtime.mjs",
    "release:validate-versions": "node scripts/validate-release-versions.mjs",
    "openclaw:release-check": "npm run openclaw:validate && npm run release:validate-versions && npm run check",
    "messenger:smoke-template": "node scripts/messenger-smoke-checklist.mjs --template",
    "messenger:smoke-validate": "node scripts/messenger-smoke-checklist.mjs --validate",
    "deploy:gateway": "test -n \"$FLY_GATEWAY_REVIEWED_IMAGE\" && node scripts/validate-production-deployment.mjs --validate-target-enabled gateway && node scripts/validate-production-deployment.mjs --validate-rollback-image gateway \"$FLY_GATEWAY_REVIEWED_IMAGE\" && fly deploy --config fly.toml --strategy rolling --image \"$FLY_GATEWAY_REVIEWED_IMAGE\"",
    "deploy:image-gen": "test -n \"$FLY_IMAGE_GEN_REVIEWED_IMAGE\" && node scripts/validate-production-deployment.mjs --validate-target-enabled image-gen && node scripts/validate-production-deployment.mjs --validate-rollback-image image-gen \"$FLY_IMAGE_GEN_REVIEWED_IMAGE\" && cd apps/image-gen && fly deploy --config fly.toml --strategy rolling --image \"$FLY_IMAGE_GEN_REVIEWED_IMAGE\"",
    "deploy:storage-proxy": "test -n \"$FLY_STORAGE_PROXY_REVIEWED_IMAGE\" && node scripts/validate-production-deployment.mjs --validate-target-enabled storage-proxy && node scripts/validate-production-deployment.mjs --validate-rollback-image storage-proxy \"$FLY_STORAGE_PROXY_REVIEWED_IMAGE\" && cd apps/image-gen/storage-proxy && fly deploy --config fly.toml --strategy rolling --image \"$FLY_STORAGE_PROXY_REVIEWED_IMAGE\"",
    "gateway:deployment-safety": "node scripts/validate-gateway-deployment-safety.mjs",
    "production:validate": "node scripts/validate-production-deployment.mjs",
    "production:drift:gateway": "node scripts/validate-production-deployment.mjs --settled-live gateway",
    "production:drift:image-gen": "node scripts/validate-production-deployment.mjs --settled-live image-gen",
    "production:drift:storage-proxy": "node scripts/validate-production-deployment.mjs --settled-live storage-proxy",
    "image-gen:install": "pnpm install --dir apps/image-gen --lockfile-dir apps/image-gen --frozen-lockfile",
    "image-gen:check": "pnpm --dir apps/image-gen check",
    "image-gen:test": "pnpm --dir apps/image-gen test",
    "image-gen:build": "pnpm --dir apps/image-gen build",
    "fallow": "npx --yes fallow@2.27.0 --root .",
    "fallow:list": "npx --yes fallow@2.27.0 --root . list",
    "fallow:production": "npx --yes fallow@2.27.0 --root . --production",
    "fallow:report": "mkdir -p .fallow && npx --yes fallow@2.27.0 --root . -f json > .fallow/report.json && node scripts/normalize-fallow-report.mjs --root . .fallow/report.json",
    "fallow:report:production": "mkdir -p .fallow && npx --yes fallow@2.27.0 --root . --production -f json > .fallow/report-production.json && node scripts/normalize-fallow-report.mjs --root . .fallow/report-production.json",
    "fallow:summary": "npx --yes fallow@2.27.0 --root . --summary --score",
    "check:product-boundaries": "node scripts/check-product-boundaries.mjs",
    "check:package-managers": "node scripts/check-package-manager-contract.mjs"
  },
  "dependencies": {
    "ioredis": "^6.0.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.6.11 || 2026.7.2-beta.7"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "openclaw": "2026.7.2-beta.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "hono": "4.12.34",
    "nanoid@3": "3.3.18"
  },
  "openclaw": {
    "compat": {
      "pluginApi": ">=2026.6.11",
      "minGatewayVersion": "2026.6.11"
    },
    "build": {
      "openclawVersion": "2026.7.2-beta.7",
      "pluginSdkVersion": "2026.7.2-beta.7"
    },
    "install": {
      "clawhubSpec": "clawhub:@dj-shortcut/facebook",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.6.11"
    },
    "extensions": [
      "./dist/index.js"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "setupEntry": "./dist/setup-entry.js",
    "runtimeSetupEntry": "./dist/setup-entry.js",
    "channel": {
      "id": "facebook",
      "label": "Facebook",
      "aliases": [
        "messenger",
        "fb",
        "fbm"
      ],
      "selectionLabel": "Facebook (Page Messenger)",
      "detailLabel": "Facebook Page",
      "docsPath": "/channels/facebook",
      "docsLabel": "facebook",
      "blurb": "Facebook Page Messenger DMs via Meta webhooks.",
      "systemImage": "message.fill",
      "preferOver": [
        "messenger"
      ],
      "exposure": {
        "configured": true,
        "setup": true,
        "docs": true
      },
      "quickstartAllowFrom": true,
      "configuredState": {
        "specifier": "./configured-state",
        "exportName": "hasFacebookConfiguredState"
      }
    }
  }
}
